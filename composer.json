{
  "name": "gosdrkht/sinhala-toolkit",
  "description": "Zero-dependency Sinhala NLP toolkit for PHP — text cleaner, tokenizer, stopwords, sentiment analysis, profanity filter & trilingual script detector | සිංහල NLP",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "sinhala",
    "sinhala-nlp",
    "sinhalese",
    "nlp",
    "natural-language-processing",
    "tokenizer",
    "text-processing",
    "text-cleaner",
    "stopwords",
    "sentiment-analysis",
    "profanity-filter",
    "unicode",
    "tamil",
    "sri-lanka",
    "php"
  ],
  "authors": [
    {
      "name": "gosdrkht",
      "homepage": "https://github.com/gosdrkht"
    }
  ],
  "homepage": "https://github.com/gosdrkht/sinhala-toolkit",
  "support": {
    "issues": "https://github.com/gosdrkht/sinhala-toolkit/issues",
    "source": "https://github.com/gosdrkht/sinhala-toolkit"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "SinhalaToolkit\\": "php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SinhalaToolkit\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  }
}
